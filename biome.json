{
    "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
    "assist": {
        "actions": {
            "source": {
                "organizeImports": {
                    "level": "on",
                    "options": {
                        "groups": [
                            [
                                ":PACKAGE:",
                                ":PACKAGE_WITH_PROTOCOL:",
                                ":NODE:",
                                ":URL:"
                            ],
                            ":BLANK_LINE:",
                            ["@/assets/**", "@/components/**", "@/views/**"],
                            ":BLANK_LINE:",
                            [
                                "@/store/**",
                                "@/hooks/**",
                                "@/lib/**",
                                "!@/lib/api/**"
                            ],
                            ":BLANK_LINE:",
                            [":ALIAS:", "!@/types/**"],
                            ":BLANK_LINE:",
                            ":PATH:",
                            ":BLANK_LINE:",
                            "@/lib/api/**",
                            ":BLANK_LINE:",
                            "@/types/**"
                        ]
                    }
                },
                "useSortedKeys": "on"
            }
        },
        "enabled": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
    },
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "domains": {
            "next": "recommended",
            "react": "recommended"
        },
        "enabled": true,
        "rules": {
            "correctness": {
                "noUnusedImports": {
                    "fix": "safe",
                    "level": "warn",
                    "options": {}
                },
                "noUnusedVariables": {
                    "level": "error",
                    "options": {}
                }
            },
            "recommended": true,
            "suspicious": {
                "noUnknownAtRules": "off"
            }
        }
    },

    "vcs": {
        "clientKind": "git",
        "defaultBranch": "production",
        "enabled": true,
        "useIgnoreFile": true
    }
}
